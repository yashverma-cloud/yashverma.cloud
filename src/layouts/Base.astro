---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getImage } from 'astro:assets';
import portrait from '../assets/yash.jpg';
import { SITE, SAME_AS } from '../consts';
import { NODE_COUNT } from '../scene/geometry';

interface Props {
  title?: string;
  description?: string;
  /** Redirect stubs and the like stay out of the index and out of analytics. */
  noindex?: boolean;
  /** Site path of a 1200×630 PNG rendered at build time (src/pages/og). */
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  /**
   * One extra node appended to this page's JSON-LD graph — a BlogPosting, for instance.
   * Kept here rather than as a second inline script per page, so there is one `@context`
   * and one place that emits structured data.
   */
  jsonLd?: Record<string, unknown>;
}

const {
  title = SITE.title,
  description = SITE.description,
  noindex = false,
  ogImage = '/og/default.png',
  ogImageAlt = `Blueprint drawing of a ${NODE_COUNT}-node Kubernetes cluster beside the line “I keep production Kubernetes running when nodes die.” ${SITE.name}, ${SITE.jobTitle}.`,
  ogType = 'website',
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
// Crawlers need absolute image URLs.
const ogImageUrl = new URL(ogImage, Astro.site ?? SITE.url).href;

// The Contact portrait, as a plain JPEG Google can use for the person.
const portraitJpg = await getImage({ src: portrait, width: 400, height: 400, format: 'jpg' });
const personId = `${SITE.url}/#person`;

const personLd = {
  '@type': 'Person',
  '@id': personId,
  name: SITE.name,
  jobTitle: SITE.jobTitle,
  description: `${SITE.jobTitle} at ${SITE.employer}, in ${SITE.location}. Autoscaling, cost and observability across multi-region production infrastructure on AWS and GCP.`,
  image: new URL(portraitJpg.src, Astro.site ?? SITE.url).href,
  url: SITE.url,
  sameAs: [...SAME_AS],
  worksFor: { '@type': 'Organization', name: SITE.employer },
  alumniOf: { '@type': 'Organization', name: 'Treebo Hospitality Ventures' },
  homeLocation: { '@type': 'Place', name: 'Jaipur, Rajasthan, India' },
  knowsAbout: [
    'Amazon Web Services',
    'Kubernetes',
    'Terraform',
    'Site reliability engineering',
    'Observability',
    'CI/CD',
  ],
};

// Google reads the site name from WebSite data on the home page only.
const websiteLd = {
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: SITE.name,
  alternateName: ['Yash Verma cloud', 'yashverma-cloud'],
  url: `${SITE.url}/`,
  about: { '@id': personId },
};
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    ...(Astro.url.pathname === '/' ? [websiteLd, personLd] : [personLd]),
    ...(jsonLd ? [jsonLd] : []),
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#15345C" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link
      rel="preload"
      href="/fonts/overpass-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.xHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
      is:inline
    />

    <script is:inline>
      // Analytics events (take_node_down, copy_email). Does nothing until GA4 has loaded,
      // and nothing at all when analytics is off, so callers never have to check.
      window.__track = function (name, params) {
        if (window.__gaReady && window.gtag) window.gtag('event', name, params || {});
      };
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />

    {
      !noindex && (
        <script is:inline define:vars={{ id: SITE.analyticsId }}>
          // Loaded after `load` so it never competes with rendering (CLAUDE.md).
          window.addEventListener('load', function () {
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
            document.head.appendChild(s);
            window.dataLayer = window.dataLayer || [];
            // Global, so window.__track can send events through it.
            window.gtag = function () {
              window.dataLayer.push(arguments);
            };
            window.gtag('js', new Date());
            window.gtag('config', id);
            window.__gaReady = true;
          });
        </script>
      )
    }
  </body>
</html>
