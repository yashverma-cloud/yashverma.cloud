---
/**
 * Fig. 3 — alerting, drawn as the path an event takes to a human (design/notes.md §7.6).
 *
 * Two facts, one drawing: the route, and what the template does to the payload on the way.
 * The block sizes are the claim — the short block is under half the tall one, which is the
 * only number on this page.
 *
 * The source box names both stacks because the work was done twice, in Grafana and later
 * in Coralogix. Two lines rather than one: "Grafana / Coralogix" on a single line is wider
 * than the box at phone widths, where labels are roughly twice as wide in user units.
 */
import Diagram from '../Diagram.astro';

interface Props {
  fig: number;
}
const { fig } = Astro.props;

const box = (x: number, w: number, y: number, h: number) =>
  `M${x} ${y} H${x + w} V${y + h} H${x} Z`;
---

<Diagram fig={fig} caption="alert path, payload">
  <svg
    viewBox="0 0 640 280"
    role="img"
    aria-label="Flow drawing. An alert from Grafana or Coralogix passes through a custom Slack template to the on-call channel. The template reduces the raw event to a title, one line on its purpose and the fields needed to act, more than halving the payload."
    xmlns="http://www.w3.org/2000/svg"
  >
    <!-- the route -->
    <path class="d" style="--i:0" pathLength="1" d={box(0, 168, 20, 68)} />
    <text x="84" y="48" text-anchor="middle" style="--i:0">Grafana</text>
    <text x="84" y="72" text-anchor="middle" style="--i:0">Coralogix</text>

    <path class="d thin" style="--i:0" pathLength="1" d="M168 54 H228 M220 48 L230 54 L220 60" />

    <path class="d" style="--i:1" pathLength="1" d={box(236, 168, 20, 68)} />
    <text x="320" y="60" text-anchor="middle" style="--i:1">Slack template</text>

    <path class="d thin" style="--i:1" pathLength="1" d="M404 54 H464 M456 48 L466 54 L456 60" />

    <path class="d" style="--i:2" pathLength="1" d={box(472, 168, 20, 68)} />
    <text x="556" y="60" text-anchor="middle" style="--i:2">on-call</text>

    <!-- what the template does to the payload -->
    <path
      class="d thin"
      style="--i:3"
      pathLength="1"
      d="M320 88 V116 H70 V144 M64 136 L70 146 L76 136"
    />

    <path class="d ghost" style="--i:3" d={box(0, 200, 152, 92)} />
    <text class="sub" x="0" y="268" style="--i:3">raw event</text>

    <path class="d thin" style="--i:4" pathLength="1" d="M200 198 H256 M248 192 L258 198 L248 204" />

    <path class="d" style="--i:4" pathLength="1" d={box(274, 200, 220, 24)} />
    <text class="sub" x="274" y="268" style="--i:4">title, purpose, fields</text>

    <text class="num" x="640" y="238" text-anchor="end" style="--i:4">&gt;50% smaller</text>
  </svg>
</Diagram>
