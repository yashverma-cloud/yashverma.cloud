---
import { getCollection } from 'astro:content';

/**
 * Proof rows — design/notes.md §5.3. Deliberately not a stat strip and not a card grid:
 * each row is a sentence, so every number carries its mechanism.
 *
 * Case-study bodies are written in Phase 4. Until an entry is out of draft its row is
 * plain text rather than a link, so the page never ships a dead destination.
 */
const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<section class="section" id="work">
  <div class="wrap">
    <div class="section-head">
      <h2>Proof</h2>
    </div>

    <ul class="rows">
      {
        work.map((item) => {
          const Inner = item.data.draft ? 'div' : 'a';
          const props = item.data.draft ? {} : { href: `/work/${item.id}/` };
          return (
            <li>
              <Inner class:list={['row', { nofigure: !item.data.figure }]} {...props}>
                {item.data.figure && <span class="figure">{item.data.figure}</span>}
                <span class="result">{item.data.result}</span>
                <span class="mechanism body-s">{item.data.mechanism}</span>
              </Inner>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .row {
    display: grid;
    gap: var(--s-1) var(--s-6);
    padding-block: var(--s-6);
    text-decoration: none;
    color: inherit;
  }

  .figure {
    font-size: var(--fs-display-m);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }

  .result {
    font-size: var(--fs-body-l);
  }

  .mechanism {
    color: var(--muted);
  }

  a.row:hover .result,
  a.row:focus-visible .result {
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 0.2em;
  }

  @media (min-width: 48rem) {
    .row {
      grid-template-columns: 6rem minmax(0, 24rem) minmax(0, 1fr);
      align-items: baseline;
    }

    /* Not every case study has a headline number, and an empty first column reads as a
       rendering fault. Those rows start their result in the figure's place instead. */
    .row.nofigure .result {
      grid-column: 1 / span 2;
    }
  }
</style>
