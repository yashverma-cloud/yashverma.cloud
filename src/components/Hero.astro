---
import ClusterPoster from './ClusterPoster.astro';
import { SITE } from '../consts';
import { NODE_COUNT, POD_COUNT } from '../scene/geometry';

/**
 * Hero — design/notes.md §5.1 and §6.
 *
 * The headline is plain HTML and is the LCP element. It must never move into a deferred
 * component and must never be rendered by script.
 *
 * Layering, in the order a visitor gets them:
 *   1. No JS      — poster at healthy state, HUD at rest, button hidden.
 *   2. JS         — button appears, simulation drives poster and HUD.
 *   3. WebGL      — scene loads after `load`, on idle, and crossfades over the poster.
 * Reduced motion stops at layer 2 with a four-state sequence and no ambient movement.
 */

const hud = [
  { key: 'nodes', label: 'nodes ready', value: `${NODE_COUNT} / ${NODE_COUNT}` },
  { key: 'pods', label: 'pods running', value: String(POD_COUNT) },
  { key: 'requests', label: 'requests served', value: '12,480' },
  { key: 'failed', label: 'failed requests', value: '0' },
  { key: 'recovery', label: 'last recovery', value: '—' },
];
---

<section class="hero">
  <div class="wrap grid">
    <div class="copy">
      <p class="micro byline">
        {`${SITE.jobTitle} at ${SITE.employer} · ${SITE.location}`}
      </p>
      <h1>I keep production Kubernetes running when nodes die.</h1>
      <p class="standfirst">
        Now at Copado: autoscaling, cost and observability across multi-region production
        infrastructure. Five years on AWS and GCP, before that at BLG and Treebo.
      </p>
    </div>

    <div class="scene" data-scene>
      <ClusterPoster />
      <div class="canvas-mount" data-canvas-mount aria-hidden="true"></div>
    </div>

    <div class="controls">
      <button class="btn take-down js-only" type="button" data-take-down>
        Take a node down
      </button>

      <div class="hud">
        <p class="hud-head"><span data-hud-mode>cluster · simulated</span></p>
        <dl class="hud-list">
          {
            hud.map((row) => (
              <div class="hud-row">
                <dt>{row.label}</dt>
                <dd class="tabular" data-hud={row.key}>
                  {row.value}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <p class="hud-compact tabular" aria-hidden="true">
        <span>
          nodes <span data-hud-c="nodes">{`${NODE_COUNT}/${NODE_COUNT}`}</span> · pods{' '}
          <span data-hud-c="pods">{POD_COUNT}</span> · failed{' '}
          <span data-hud-c="failed">0</span>
        </span>
        <span>
          simulated · last recovery <span data-hud-c="recovery">—</span>
        </span>
      </p>
    </div>

    <p class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-live>
    </p>
  </div>
</section>

<script>
  import { mountHero } from '../scene/hero-controller';
  mountHero();
</script>

<style>
  .hero {
    padding-block: var(--s-8) var(--s-12);
  }

  .grid {
    display: grid;
    gap: var(--s-6);
  }

  .byline {
    margin-bottom: var(--s-4);
  }

  h1 {
    max-width: var(--measure-display);
    margin-bottom: var(--s-6);
  }

  /* The canvas sits exactly over the poster, same box, so the crossfade cannot shift
     anything. The poster keeps reserving the space even once the canvas is live. */
  .scene {
    position: relative;
  }

  .canvas-mount {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .scene[data-webgl='on'] .canvas-mount {
    opacity: 1;
  }

  /* Only the poster's artwork gives way to the canvas. Its <text> stays — SVG text has no
     WebGL equivalent, and losing the AZ and ingress labels costs the scene its legibility.
     The poster is lifted above the canvas so those labels are not painted over. */
  .scene :global(.poster) {
    position: relative;
    z-index: 1;
  }

  .scene[data-webgl='on'] :global(.poster polygon),
  .scene[data-webgl='on'] :global(.poster path) {
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .canvas-mount :global(canvas) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .take-down {
    margin-bottom: var(--s-6);
  }

  .take-down[disabled] {
    opacity: 0.55;
    cursor: default;
  }

  .hud {
    font-family: var(--font-mono);
    font-size: var(--fs-body-s);
  }

  .hud-list {
    margin: 0;
  }

  .hud-head {
    font-size: var(--fs-micro);
    color: var(--muted);
    padding-bottom: var(--s-2);
    border-bottom: 1px solid var(--rule-faint);
    margin-bottom: var(--s-3);
  }

  .hud-row {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
    padding-block: 1px;
  }

  .hud dt {
    color: var(--muted);
  }

  .hud dd {
    margin: 0;
    color: var(--line);
  }

  /* Phone: the five-row HUD is replaced by the two-line version. */
  .hud {
    display: none;
  }

  .hud-compact {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    font-family: var(--font-mono);
    font-size: var(--fs-body-s);
    color: var(--muted);
    padding-top: var(--s-3);
    border-top: 1px solid var(--rule-faint);
  }

  @media (max-width: 30rem) {
    .take-down {
      width: 100%;
    }
  }

  @media (min-width: 60rem) {
    .hero {
      padding-block: var(--s-16) var(--s-24);
    }

    .grid {
      grid-template-columns: 5fr 7fr;
      column-gap: var(--s-12);
      align-items: start;
    }

    .copy {
      grid-column: 1;
    }

    /* Spans both copy rows and centres against them, so the scene carries real weight
       against the headline rather than floating in the top corner. */
    .scene {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: center;
    }

    .controls {
      grid-column: 1;
      max-width: 22rem;
    }

    .hud {
      display: block;
    }

    .hud-compact {
      display: none;
    }

    .hud-row {
      padding-block: 2px;
    }
  }
</style>
