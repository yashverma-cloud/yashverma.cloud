---
import { getEntry } from 'astro:content';

/**
 * Stack — design/notes.md §5.6. One line per tool saying what Yash did with it.
 * No logos, no icons, no proficiency bars, no "years of experience".
 *
 * Rule (revised in the Phase 2 review): every core tool appears, with a line specific
 * to Yash's use of it. A tool does not need a headline metric to earn a place — the
 * numbers live in the proof rows and case studies. The earlier rule conflated "no
 * impressive number" with "no specific line" and hid most of his stack from the
 * recruiters who search this page for exactly these words.
 *
 * Every line below is drawn from Yash's resume or his own account. Nothing inferred.
 */
const stack = [
  {
    name: 'Kubernetes, EKS and Docker',
    did: 'Production clusters continuously since 2021, across development, QA and multi-region production.',
  },
  {
    name: 'Karpenter',
    did: 'Took it from a proof of concept through to every production environment, retiring the Cluster Autoscaler node groups it superseded.',
  },
  {
    name: 'Terraform',
    did: 'Effectively the whole estate is managed as code — networking, clusters, IAM, secrets, registries and CI/CD. Observability alerting is under Terraform now too.',
  },
  {
    name: 'Helm',
    did: 'Applications and platform components ship as charts. Day to day that means authoring, releasing and upgrading them in production.',
  },
  {
    name: 'AWS',
    did: 'EKS, EC2, RDS, S3, Lambda, ECR, Route 53, WAF, Secrets Manager, SES, CloudWatch and DMS across multi-account estates.',
  },
  {
    name: 'GCP',
    did: 'Production workloads alongside AWS.',
  },
  {
    name: 'OpenTelemetry and Coralogix',
    did: 'Consolidated log routing onto OpenTelemetry and tuned labelling to keep ingestion efficient. Built custom Coralogix-to-Slack alert templates: a severity title, one line on what the alert is for, and only the fields needed to act.',
  },
  {
    name: 'Prometheus, Grafana and ELK',
    did: 'Metrics, dashboards and alerting for the services I run — built to improve MTTR, not to fill a wall.',
  },
  {
    name: 'AWS SSO and IAM',
    did: 'Multi-account governance with enforced production isolation, least-privilege roles, application-scoped access and permission sets.',
  },
  {
    name: 'GitHub Actions and Jenkins',
    did: 'Build and deploy pipelines for application and infrastructure repositories, including maintaining legacy Jenkins jobs.',
  },
  {
    name: 'Python',
    did: 'Operational tooling — a Slack bot for safe cluster access, and release-verification automation now used by the team.',
  },
  {
    name: 'Networking',
    did: 'VPC design, subnetting and routing, NAT and internet gateways, load balancing and WAF, multi-AZ across staging and production.',
  },
];

// One quiet line under the list, not a row of its own: the runbook is a reference Yash keeps,
// not a tool he ran. "Over 250" rather than the exact count, so the line stays true as it grows.
const runbook = await getEntry('links', 'runbook');
---

<section class="section" id="stack">
  <div class="wrap">
    <div class="section-head">
      <h2>Stack</h2>
    </div>

    {/* A <dl> may only contain dt/dd, or <div>s wrapping them — never <li>. */}
    <dl class="stack-list">
      {
        stack.map((item) => (
          <div class="row">
            <dt>{item.name}</dt>
            <dd>{item.did}</dd>
          </div>
        ))
      }
    </dl>

    {
      runbook && (
        <p class="runbook body-s">
          The commands I reach for are public too: my{' '}
          <a href={runbook.data.url}>{runbook.data.label}</a>, over 250 of them, searchable.
        </p>
      )
    }
  </div>
</section>

<style>
  .stack-list {
    margin: 0;
    border-top: 1px solid var(--rule-faint);
  }

  .row {
    display: grid;
    gap: var(--s-1) var(--s-8);
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--rule-faint);
  }

  dt {
    font-weight: 600;
  }

  dd {
    margin: 0;
    color: var(--muted);
    max-width: var(--measure-prose);
  }

  .runbook {
    margin-top: var(--s-6);
    color: var(--muted);
    max-width: var(--measure-prose);
  }

  @media (min-width: 48rem) {
    .row {
      grid-template-columns: 16rem minmax(0, 1fr);
      align-items: baseline;
    }
  }
</style>
