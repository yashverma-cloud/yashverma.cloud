---
/**
 * Static blueprint poster of the cluster — design/notes.md §6.1.
 *
 * This is the LCP-safe, JS-free state of the hero: it renders immediately, reserves the
 * canvas box so CLS stays 0, and is what a visitor sees under reduced motion, without
 * WebGL, or with JS off. Phase 3 loads the Three.js scene behind it and crossfades.
 *
 * All geometry comes from src/scene/geometry.ts, which Phase 3's camera must match.
 */
import { SCENE_LABEL, VIEWBOX, VIEWBOX_ATTR, scene } from '../scene/geometry';

const { ingress, zones } = scene;
---

<div class="poster-wrap">
  <svg
    class="poster"
    viewBox={VIEWBOX_ATTR}
    style={`--poster-ratio: ${VIEWBOX.w} / ${VIEWBOX.h}`}
    role="img"
    aria-label={SCENE_LABEL}
    xmlns="http://www.w3.org/2000/svg"
  >
  <g class="links">
    {
      zones.map((zone) => (
        <path
          data-zone={zone.id}
          d={`M ${ingress.out.x} ${ingress.out.y} L ${zone.top.x} ${zone.top.y}`}
        />
      ))
    }
  </g>

  <g class="ingress">
    <polygon points={ingress.tile} />
    <text x={ingress.label.x} y={ingress.label.y - 10} text-anchor="middle">ingress</text>
  </g>

  {
    zones.map((zone) => (
      <g class="zone">
        <polygon class="plate" points={zone.plate} />
        {zone.nodes.map((node) => (
          <g class="node" data-node={node.id} data-pods={node.podsAtRest}>
            <rect class="hit" x={node.hit.x} y={node.hit.y} width={node.hit.w} height={node.hit.h} />
            <polygon class="face-left" points={node.left} />
            <polygon class="face-right" points={node.right} />
            <polygon class="face-top" points={node.top} />
            {node.podSlots.map((pod, i) => (
              <polygon class="pod" data-slot={i} points={pod} />
            ))}
          </g>
        ))}
          <text x={zone.label.x} y={zone.label.y + 16} text-anchor="middle">
            {`AZ-${zone.id}`}
          </text>
        </g>
      ))
    }
  </svg>
</div>

<style>
  /* The wrapper is the query container, so the labels size against the drawing's own
     width rather than the viewport's. Keyed to the viewport they ballooned at the
     in-between widths where the hero is still one column but the column is wide. */
  .poster-wrap {
    container-type: inline-size;
    max-width: 40rem;
  }

  .poster {
    width: 100%;
    height: auto;
    /* Reserves the box before paint so the Phase 3 canvas swap costs no layout shift. */
    aspect-ratio: var(--poster-ratio);
  }

  polygon,
  path {
    fill: none;
    stroke: var(--line);
    stroke-width: 1;
    stroke-linejoin: round;
  }

  .links path {
    stroke: var(--rule);
    stroke-dasharray: 3 5;
  }

  .plate {
    stroke: var(--rule);
  }

  /* Painted, so it takes pointer events; transparent, so it is never seen. */
  .hit {
    fill: transparent;
  }

  .face-left,
  .face-right {
    fill: var(--deep);
  }

  .face-top {
    fill: color-mix(in srgb, var(--deep) 70%, var(--blueprint));
  }

  .pod {
    fill: var(--line);
    stroke: none;
    transition: opacity 240ms ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  /* While the plotter is drawing, the scene is outline only — no fills and no pods.
     The power comes on when this attribute is removed. */
  .poster[data-load] .pod {
    opacity: 0;
  }

  .poster[data-load] .face-top,
  .poster[data-load] .face-left,
  .poster[data-load] .face-right,
  .poster[data-load] .ingress polygon {
    fill: none;
  }

  /* Pods are capacity slots: the first N are filled, the rest are spare capacity.
     Driven by data-pods so both renderers and the no-WebGL fallback agree. */
  .node[data-pods='0'] .pod,
  .node[data-pods='1'] .pod[data-slot='1'],
  .node[data-pods='1'] .pod[data-slot='2'],
  .node[data-pods='1'] .pod[data-slot='3'],
  .node[data-pods='2'] .pod[data-slot='2'],
  .node[data-pods='2'] .pod[data-slot='3'],
  .node[data-pods='3'] .pod[data-slot='3'] {
    opacity: 0;
  }

  /* --- Failure states. Signal is reserved for exactly this. --- */

  .node {
    transition: opacity 240ms ease;
  }

  .node[data-status='failed'] .face-top,
  .node[data-status='failed'] .face-left,
  .node[data-status='failed'] .face-right {
    stroke: var(--signal);
    stroke-dasharray: 4 3;
    fill: color-mix(in srgb, var(--signal) 12%, var(--deep));
  }

  .node[data-status='provisioning'] .face-top,
  .node[data-status='provisioning'] .face-left,
  .node[data-status='provisioning'] .face-right {
    stroke: var(--muted);
    stroke-dasharray: 3 4;
    fill: none;
  }

  /* The link into a dead zone stops carrying traffic. */
  .links path[data-state='down'] {
    opacity: 0.15;
  }

  /* Sized in user units, so the rendered size depends on how far the SVG is scaled.
     Both values land at roughly 10–13 rendered px across the poster's whole width range. */
  text {
    fill: var(--muted);
    font-family: var(--font-mono);
    font-size: 16px;
    letter-spacing: 0.02em;
  }

  @container (min-width: 30rem) {
    text {
      font-size: 12px;
    }
  }
</style>
