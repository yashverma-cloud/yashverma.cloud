---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection } from 'astro:content';

// Thin sticky bar, 52px (design/notes.md §5.1). Sentence case, no ALL-CAPS.
//
// `narrow` marks the items that survive at phone widths. Work stays because it is the
// route to the proof, and phones are where most of the site's traffic lands — hiding it
// there optimised the bar for tidiness over the page's actual job.
//
// "Writing" needs two things: the section's routes must be built, and a post must be
// published. The section is parked by renaming its route folder to `src/pages/_writing`,
// which Astro does not build (README, "Parked: /writing"). Checking for the routed folder
// means a post published while the section is parked cannot put a link to a missing page
// in the nav. It sits before Contact, which is where the page is meant to end, and is
// `narrow: false` because a fourth item is what would crowd the bar at 360px.
const routed = existsSync(join(process.cwd(), 'src/pages/writing'));
const published = routed ? await getCollection('writing', ({ data }) => !data.draft) : [];

const nav = [
  { label: 'Work', href: '/#work', narrow: true },
  { label: 'Experience', href: '/#experience', narrow: false },
  ...(published.length > 0 ? [{ label: 'Writing', href: '/writing', narrow: false }] : []),
  { label: 'Contact', href: '/#contact', narrow: true },
];
---

<header class="bar">
  <div class="wrap bar-inner">
    <a class="wordmark" href="/">Yash Verma</a>
    <nav aria-label="Sections">
      <ul>
        {
          nav.map((item) => (
            <li class:list={{ wide: !item.narrow }}>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    background: var(--blueprint);
    border-bottom: 1px solid var(--rule-faint);
  }

  .bar-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
  }

  .wordmark {
    font-weight: 700;
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  nav ul {
    display: flex;
    gap: var(--s-6);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  nav a {
    font-size: var(--fs-micro);
    font-weight: 600;
    letter-spacing: var(--tr-micro);
    color: var(--muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--line);
  }

  /* Phones keep Work and Contact; only Experience drops, which is what made the bar
     tight. Verified to fit at 390px and at 360px. */
  @media (max-width: 34rem) {
    nav ul {
      gap: var(--s-4);
    }

    nav li.wide {
      display: none;
    }
  }
</style>
