---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE } from '../../consts';
import { formatDay } from '../../utils/dates';

/**
 * Post pages.
 *
 * PARKED — the `_` in this folder's name keeps Astro from building it. To bring the section
 * back, follow "Parked: /writing" in README.md.
 *
 * The prose here is deliberately *not* `.prose-grid` from the case-study page. That grid pins
 * every `h2` into a 10rem left column, which is right for three fixed labels — Problem, What
 * I did, Result — and wrong for a post, where headings are part of the reading order and a
 * label column would turn each one into a margin note.
 *
 * Only published entries build, so a draft has no page, no card and no sitemap entry.
 */
export const getStaticPaths = (async () => {
  const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort((a, b) =>
    b.data.published === a.data.published
      ? a.id.localeCompare(b.id)
      : b.data.published.localeCompare(a.data.published),
  );
  return posts.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, older: posts[i + 1] },
  }));
}) satisfies GetStaticPaths;

const { entry, older } = Astro.props;
const { Content } = await render(entry);

// Built the same way Base builds the canonical, so the two can never disagree.
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = `/og/writing/${entry.id}.png`;

const postLd = {
  '@type': 'BlogPosting',
  '@id': `${canonical}#post`,
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.published,
  ...(entry.data.updated ? { dateModified: entry.data.updated } : {}),
  // The Person node Base already emits on every page, rather than a second copy of it.
  author: { '@id': `${SITE.url}/#person` },
  publisher: { '@id': `${SITE.url}/#person` },
  image: new URL(ogImage, SITE.url).href,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  inLanguage: 'en',
};
---

<Base
  title={`${entry.data.title} — ${SITE.name}`}
  description={entry.data.description}
  ogImage={ogImage}
  ogImageAlt={`Writing by ${SITE.name}: ${entry.data.title}.`}
  ogType="article"
  jsonLd={postLd}
>
  <article class="section">
    <div class="wrap">
      <p class="micro back"><a href="/writing">← Writing</a></p>
      <header class="post-head">
        <h1 class="title">{entry.data.title}</h1>
        <p class="meta">
          <time class="micro" datetime={entry.data.published}>
            {formatDay(entry.data.published)}
          </time>
          {
            entry.data.updated && (
              <time class="micro updated" datetime={entry.data.updated}>
                · updated {formatDay(entry.data.updated)}
              </time>
            )
          }
        </p>
        <p class="standfirst">{entry.data.description}</p>
      </header>

      <div class="prose-body">
        <Content />
      </div>

      <p class="foot">
        {older && <a href={`/writing/${older.id}`}>Older: {older.data.title}</a>}
        <a class="all" href="/writing">All posts</a>
      </p>
    </div>
  </article>
</Base>

<style>
  .back {
    margin-bottom: var(--s-8);
  }

  .title {
    font-size: var(--fs-display-l);
    line-height: var(--lh-display-l);
    letter-spacing: var(--tr-display-l);
    max-width: 28ch;
    margin-bottom: var(--s-3);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-bottom: var(--s-4);
  }

  .updated {
    color: var(--muted);
  }

  /*
   * The rule belongs to the header, not to the standfirst. The standfirst keeps its own 46ch
   * measure — a deck reads badly at the full prose width — but a rule that stopped at 46ch
   * while the prose below ran to 66ch read as a misaligned edge rather than a divider.
   */
  .post-head {
    max-width: var(--measure-prose);
    margin-bottom: var(--s-12);
    padding-bottom: var(--s-8);
    border-bottom: 1px solid var(--rule-faint);
  }

  /*
   * One column at the prose measure. Row gap rather than paragraph margins, so the rhythm is
   * set in one place; headings then add to that gap instead of fighting a collapsed margin.
   * `--prose-measure` is the registered property from base.css: it makes a code block end
   * where the paragraphs beside it end, measured in the prose font rather than the mono one.
   */
  .prose-body {
    display: grid;
    row-gap: var(--s-4);
    --prose-measure: var(--measure-prose);
  }

  .prose-body > :global(*) {
    max-width: var(--measure-prose);
  }

  .prose-body > :global(h2) {
    font-size: var(--fs-display-m);
    line-height: var(--lh-display-m);
    letter-spacing: var(--tr-display-m);
    margin-top: var(--s-8);
  }

  .prose-body > :global(h3) {
    font-size: var(--fs-body-l);
    line-height: var(--lh-body-l);
    letter-spacing: 0;
    font-weight: 600;
    margin-top: var(--s-6);
  }

  .prose-body > :global(h2:first-child),
  .prose-body > :global(h3:first-child) {
    margin-top: 0;
  }

  .prose-body > :global(ul),
  .prose-body > :global(ol) {
    padding-left: var(--s-4);
  }

  .prose-body > :global(li) {
    margin-bottom: var(--s-2);
  }

  /* A hairline in the margin, like every other quiet edge on the site. No quote marks. */
  .prose-body > :global(blockquote) {
    padding-left: var(--s-4);
    border-left: 1px solid var(--rule);
    color: var(--muted);
  }

  .prose-body > :global(pre) {
    max-width: min(100%, var(--prose-measure));
  }

  .prose-body > :global(hr) {
    width: 100%;
    height: 0;
    border: 0;
    border-top: 1px solid var(--rule-faint);
    margin-block: var(--s-4);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2) var(--s-6);
    margin-top: var(--s-16);
    padding-top: var(--s-4);
    border-top: 1px solid var(--rule-faint);
    font-size: var(--fs-body-l);
  }

  /* Pushed to the end so it is not mistaken for the older-post link beside it — but when it is
     the only link on the row, being shoved to the far right just leaves it stranded. */
  .all {
    margin-left: auto;
    font-size: var(--fs-body);
    color: var(--muted);
  }

  .all:only-child {
    margin-left: 0;
  }
</style>
