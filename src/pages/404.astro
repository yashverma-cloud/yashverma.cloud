---
import Page from '../system/Page.astro';
import NotFound from '../system/components/NotFound.astro';
import ScenePoster from '../system/components/ScenePoster.astro';
import { poster } from '../altitude/posters';
import { SITE } from '../consts';

/** Lost in the cloud: the page sits inside the deck, where there is nothing to see but the way home. */
const cloud = await poster('scenes/in-cloud');
---

<Page title={`Page not found — ${SITE.name}`} noindex>
  <div class="lost">
    {cloud && <ScenePoster set={cloud} eager class="lost-still" />}
    <NotFound />
  </div>
</Page>

<style>
  .lost {
    position: relative;
    isolation: isolate;
    background: var(--deck);
  }

  .lost :global(.lost-still) {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
</style>
