---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import Page from '../../system/Page.astro';
import SceneFrame from '../../system/components/SceneFrame.astro';
import ScenePoster from '../../system/components/ScenePoster.astro';
import { poster } from '../../altitude/posters';
import { SCENES } from '../../altitude/scenes/catalogue';
import { SITE } from '../../consts';

/**
 * Case-study pages. Each opens on its own scene: the system drawn as white linework on the
 * survey sheet, playing once as the page opens (live), or its rendered still. Then the case
 * study itself: Problem, What I did, Result, with the labels in the margin.
 *
 * Only non-draft entries generate a page, so the site never ships a placeholder.
 */
export const getStaticPaths = (async () => {
  const work = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: work[(i + 1) % work.length] },
  }));
}) satisfies GetStaticPaths;

const { entry, next } = Astro.props;
const { Content } = await render(entry);
const scene = SCENES[entry.id as keyof typeof SCENES];
const still = await poster(`scenes/${entry.id}`);
const figure = entry.data.figure?.replace(/^(\d+)s$/, '$1 s');
const meta = [entry.data.employer, entry.data.year].filter(Boolean).join(' · ');
const description = [entry.data.figure, entry.data.result].filter(Boolean).join(' ').concat(`. ${entry.data.mechanism}.`);
---

<Page
  title={`${entry.data.title} — ${SITE.name}`}
  description={description}
  ogImage={`/og/work/${entry.id}.png`}
  ogImageAlt={`Case study by ${SITE.name}: ${entry.data.title}. ${scene?.alt ?? ''}`.trim()}
  ogType="article"
  nav="over"
>
  <Fragment slot="head">
    <script is:inline>
      // Live or still, decided before first paint (src/altitude/work.ts may still fall back).
      (function () {
        var d = document.documentElement;
        var q = new URLSearchParams(location.search);
        var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        var save = navigator.connection && navigator.connection.saveData;
        var forced = q.get('mode');
        d.dataset.mode = forced === 'still' || forced === 'live' ? forced : !reduce && 'WebGL2RenderingContext' in window && !save ? 'live' : 'still';
      })();
    </script>
  </Fragment>

  <div class="opening" data-work-stage={entry.id}>
    {still && <ScenePoster set={still} alt={scene?.alt} eager class="still" />}
    <canvas class="scene-canvas" data-canvas aria-hidden="true"></canvas>
    <svg class="leaders" data-leaders aria-hidden="true"></svg>
    <div class="labels" data-labels aria-hidden="true"></div>
    <SceneFrame
      id="case"
      as="h1"
      title={entry.data.title}
      figure={figure}
      result={entry.data.figure ? entry.data.result : undefined}
    >
      <p class="mechanism t-lead">{entry.data.mechanism}</p>
    </SceneFrame>
    <p class="back t-small"><a href="/#work">← Work</a></p>
  </div>

  <article class="case" aria-labelledby="case-title">
    {meta && <p class="meta t-data bleed">{meta}</p>}
    <div class="prose bleed">
      <Content />
    </div>
    {
      next && next.id !== entry.id && (
        <p class="next bleed">
          <span class="t-small">Next</span>
          <a class="t-title" href={`/work/${next.id}/`}>
            {next.data.title}
          </a>
        </p>
      )
    }
  </article>

  <script>
    import { bootWork } from '../../altitude/work';
    bootWork();
  </script>
</Page>

<style>
  .opening {
    position: relative;
    isolation: isolate;
  }

  /* Still, then the live scene over it in the same box (the crossfade moves nothing), then
     the labels, then the words. */
  .opening :global(.still),
  .scene-canvas,
  .leaders,
  .labels {
    position: absolute;
    inset: 0 0 auto 0;
    width: 100%;
    height: 100lvh;
    pointer-events: none;
  }

  .opening :global(.still) {
    z-index: 0;
  }

  .scene-canvas {
    z-index: 1;
    opacity: 0;
    transition: opacity var(--dur-slow) var(--ease-settle);
  }

  .opening[data-stage='on'] .scene-canvas {
    opacity: 1;
  }

  /* Labels near an edge must never widen the page: a phone would zoom the whole page out. */
  .leaders,
  .labels {
    z-index: 2;
    overflow: hidden;
  }

  .opening :global(.frame) {
    z-index: 3;
    background: transparent;
  }

  .leaders :global(line) {
    stroke: var(--ink-2);
    stroke-width: var(--w-hairline);
    vector-effect: non-scaling-stroke;
  }

  .labels :global(.label) {
    position: absolute;
    left: 0;
    top: 0;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: var(--t-data);
    letter-spacing: var(--tr-data);
    color: var(--ink);
    opacity: 0;
  }

  .labels :global(.label[data-amber]) {
    color: var(--sun);
  }

  .labels :global(.label .tick) {
    color: var(--ink-2);
  }

  .back {
    position: absolute;
    z-index: 4;
    left: var(--margin);
    top: calc(env(safe-area-inset-top) + var(--nav-h) + var(--space-s));
  }

  .back a {
    color: var(--ink-2);
  }

  .mechanism {
    color: var(--ink-2);
    max-width: 24em;
  }

  :root:not([data-mode='live']) .scene-canvas,
  :root:not([data-mode='live']) .leaders,
  :root:not([data-mode='live']) .labels {
    display: none;
  }

  .case {
    position: relative;
    z-index: var(--z-copy);
    background: var(--sheet);
    padding-block: var(--space-2xl) var(--space-3xl);
    border-top: var(--w-hairline) solid var(--rule-faint);
  }

  .meta {
    color: var(--ink-2);
    margin-bottom: var(--space-l);
  }

  /*
   * Problem / What I did / Result: each label in the margin, level with its first paragraph.
   * Every label is pinned to the first columns and everything else to the text columns, so
   * grid auto-placement starts a new row at each label (as the v2 page did).
   */
  .prose {
    row-gap: var(--space-s);
    align-items: start;
  }

  .prose > :global(h2) {
    grid-column: 1 / span 3;
    font-size: var(--t-small);
    font-weight: 560;
    color: var(--ink-2);
    padding-top: 0.35em;
    border-top: var(--w-hairline) solid var(--rule);
  }

  .prose > :global(:not(h2)) {
    grid-column: 4 / span 7;
    max-width: var(--measure);
  }

  .prose > :global(h2:not(:first-child)),
  .prose > :global(h2:not(:first-child) + *) {
    margin-top: var(--space-xl);
  }

  .prose > :global(ul) {
    padding-left: 1.2em;
    display: grid;
    row-gap: var(--space-2xs);
  }

  .prose > :global(pre) {
    max-width: min(100%, 52rem);
  }

  .next {
    margin-top: var(--space-2xl);
    padding-top: var(--space-m);
    border-top: var(--w-hairline) solid var(--rule-faint);
    row-gap: var(--space-2xs);
  }

  .next span {
    color: var(--ink-2);
  }

  .next a {
    grid-column: 1 / span 9;
  }

  @media (max-width: 60rem) {
    .prose > :global(h2),
    .prose > :global(:not(h2)) {
      grid-column: 1 / -1;
    }

    .prose > :global(h2:not(:first-child) + *) {
      margin-top: 0;
    }
  }
</style>
