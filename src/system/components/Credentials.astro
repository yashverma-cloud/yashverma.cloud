---
/**
 * Certifications and education: name, issuer and date. Earned credentials only; nothing in
 * progress, no badges, no credential IDs, no counts.
 */
import { getCollection } from 'astro:content';
import { formatMonth } from '../../utils/dates';

const certs = await getCollection('certifications');
---

<ul class="rows" role="list">
  {
    certs.map((c) => (
      <li class="row row-grid">
        <div class="what">
          <h3 class="name t-lead">{c.data.name}</h3>
          {c.data.includes && (
            <ul class="includes t-small" role="list">
              {c.data.includes.map((name) => (
                <li>{name}</li>
              ))}
            </ul>
          )}
        </div>
        <p class="meta t-data">
          {c.data.issuer} · {formatMonth(c.data.date)}
        </p>
      </li>
    ))
  }
  <li class="row row-grid">
    <div class="what">
      <h3 class="name t-lead">Bachelor of Engineering, Computer Science</h3>
    </div>
    <p class="meta t-data">Chandigarh University · 2018–2022</p>
  </li>
</ul>

<style>
  .row {
    align-items: baseline;
    padding-block: var(--space-m);
  }

  .what {
    grid-column: 1 / span 9;
  }

  .name {
    font-weight: 460;
  }

  .includes {
    list-style: none;
    padding: 0;
    margin-top: var(--space-xs);
    color: var(--ink-2);
    columns: 2;
    column-gap: var(--gap);
    max-width: 52em;
  }

  .includes li {
    break-inside: avoid;
    padding-block: 0.15em;
  }

  .meta {
    grid-column: 10 / -1;
    text-align: right;
    color: var(--ink-3);
  }

  @media (max-width: 60rem) {
    .what,
    .meta {
      grid-column: 1 / -1;
      text-align: left;
    }

    .meta {
      margin-top: var(--space-2xs);
    }

    .includes {
      columns: 1;
    }
  }
</style>
