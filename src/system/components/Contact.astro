---
/**
 * Contact: the name first with the role below it, one line on how to reach Yash, and the
 * actions. LinkedIn is the one filled element; the email address is assembled in the browser
 * and never appears as a raw mailto: in the HTML. No phone number, no resume.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import portrait from '../../assets/yash.jpg';
import { EMAIL_PARTS, SITE } from '../../consts';

const links = (await getCollection('links')).sort((a, b) => a.data.order - b.data.order);
const primary = links.find((l) => l.data.kind === 'primary');
const github = links.find((l) => l.data.id === 'github');
---

<div class="contact bleed">
  <div class="who">
    <Image class="portrait" src={portrait} alt="" width={72} height={72} densities={[1, 2, 3]} />
    <div>
      <p class="name t-title">{SITE.name}</p>
      <p class="role t-small">{SITE.jobTitle}</p>
      <p class="place t-small">{SITE.location}</p>
    </div>
  </div>

  <p class="intro t-lead">
    LinkedIn is the fastest way to reach me. If you would rather email, the address copies to your clipboard with one
    click.
  </p>

  <div class="actions">
    {
      primary && (
        <a class="btn btn-primary" href={primary.data.url} rel="me">
          Message me on LinkedIn
        </a>
      )
    }
    <button class="btn js-only" type="button" id="copy-email" data-idle="Copy email">Copy email</button>
    {
      github && (
        <a class="btn" href={github.data.url} rel="me">
          <svg class="gh" viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
          </svg>
          {github.data.label}
        </a>
      )
    }
    <span class="visually-hidden" role="status" id="copy-status"></span>
  </div>
</div>

<script is:inline define:vars={{ parts: [...EMAIL_PARTS] }}>
  (function () {
    var btn = document.getElementById('copy-email');
    var status = document.getElementById('copy-status');
    if (!btn) return;
    var address = parts[0] + String.fromCharCode(64) + parts[1];

    btn.addEventListener('click', function () {
      var done = function (ok) {
        btn.textContent = ok ? 'Copied' : address;
        if (status) status.textContent = ok ? 'Email address copied.' : address;
        // The outcome only; the address itself is never sent to analytics.
        if (window.__track) window.__track('copy_email', { result: ok ? 'copied' : 'shown' });
        window.setTimeout(function () {
          btn.textContent = btn.dataset.idle || 'Copy email';
        }, 2000);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(address).then(
          function () { done(true); },
          function () { done(false); },
        );
      } else {
        done(false);
      }
    });
  })();
</script>

<style>
  .contact {
    row-gap: var(--space-l);
    align-items: end;
  }

  .who {
    grid-column: 1 / span 4;
    display: flex;
    align-items: center;
    gap: var(--space-s);
  }

  .portrait {
    flex: none;
    width: 72px;
    height: 72px;
    object-fit: cover;
    border: var(--w-hairline) solid var(--rule);
  }

  .name {
    font-weight: 380;
    font-stretch: 125%;
  }

  .role {
    margin-top: var(--space-3xs);
    color: var(--ink);
  }

  .place {
    color: var(--ink-2);
  }

  .intro {
    grid-column: 5 / span 4;
    max-width: 24em;
  }

  .actions {
    grid-column: 9 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    justify-content: flex-end;
  }

  .gh {
    margin-top: -0.1em;
  }

  @media (max-width: 75rem) {
    .who,
    .intro,
    .actions {
      grid-column: 1 / -1;
      justify-content: flex-start;
    }
  }

  @media (max-width: 30rem) {
    .actions .btn {
      width: 100%;
    }
  }
</style>
