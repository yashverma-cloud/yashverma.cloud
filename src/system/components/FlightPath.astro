---
/**
 * Experience as a flight path: one route line down the page, the roles as fixes on it, newest
 * first, with their dates as the altitude markers beside the line. A filled triangle (a fix on
 * an approach chart) marks the current role, hollow ones the past. The route is dashed where
 * it is planned and solid where it has been flown: with a script, the flown part follows the
 * scroll (--flown, 0 to 1); without one, the whole route is flown.
 */
import { getCollection } from 'astro:content';
import { formatMonth, isoRange } from '../../utils/dates';

const roles = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
---

<div class="fp bleed" data-flightpath>
  <ol class="legs" role="list">
    {
      roles.map((r) => (
        <li class:list={['leg', { current: !r.data.end }]}>
          <time class="when t-data" datetime={isoRange(r.data.start, r.data.end)}>
            <span>{formatMonth(r.data.start)} –</span> <span>{r.data.end ? formatMonth(r.data.end) : 'present'}</span>
          </time>
          <svg class="fix" viewBox="0 0 14 12" aria-hidden="true" focusable="false">
            <path d="M7 1.2 L12.8 11 L1.2 11 Z" />
          </svg>
          <div class="what">
            <h3 class="role t-title">{r.data.role}</h3>
            <p class="org t-small">
              {r.data.company} · {r.data.location}
            </p>
          </div>
          {r.data.summary && <p class="sum">{r.data.summary}</p>}
        </li>
      ))
    }
  </ol>
</div>

<script>
  // The flown part of the route follows the scroll; without a script the route is all flown.
  const fp = document.querySelector<HTMLElement>('[data-flightpath]');
  if (fp && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    fp.style.setProperty('--flown', '0');
    let queued = false;
    const update = () => {
      queued = false;
      const r = fp.getBoundingClientRect();
      const t = (window.innerHeight * 0.62 - r.top) / Math.max(1, r.height);
      fp.style.setProperty('--flown', String(Math.min(1, Math.max(0, t))));
    };
    const on = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting) window.addEventListener('scroll', on, { passive: true });
      else window.removeEventListener('scroll', on);
      update();
    }).observe(fp);
  }
</script>

<style>
  .legs {
    /* The route's distance from the list's left edge: the middle of the gap after column 2. */
    --route: calc((100% - var(--gap) * 11) / 12 * 2 + var(--gap) * 1.5);
    position: relative;
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
    row-gap: var(--space-xl);
  }

  /* The route: flown (solid) over planned (dashed). */
  .legs::before {
    content: '';
    position: absolute;
    top: 0.4em;
    bottom: 0;
    left: var(--route);
    width: var(--w-hairline);
    background:
      linear-gradient(var(--ink-2), var(--ink-2)) top / 100% calc(var(--flown, 1) * 100%) no-repeat,
      repeating-linear-gradient(to bottom, var(--rule) 0 6px, transparent 6px 12px);
  }

  /* An altimeter's graduations beside it. */
  .legs::after {
    content: '';
    position: absolute;
    top: 0.4em;
    bottom: 0;
    left: calc(var(--route) - 7px);
    width: 5px;
    background: repeating-linear-gradient(to bottom, var(--rule-faint) 0 1px, transparent 1px 24px);
  }

  .leg {
    position: relative;
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
    align-items: baseline;
  }

  .when {
    grid-column: 1 / span 2;
    justify-self: end;
    text-align: right;
    color: var(--ink-2);
    padding-right: var(--space-2xs);
  }

  /* A range breaks after its dash or not at all. */
  .when span {
    white-space: nowrap;
  }

  .what {
    grid-column: 3 / span 4;
    padding-left: var(--space-2xs);
  }

  .org {
    margin-top: var(--space-3xs);
    color: var(--ink-2);
  }

  .sum {
    grid-column: 7 / -1;
    color: var(--ink-2);
    max-width: var(--measure);
  }

  /* The fix, centred on the route, level with the role's first line. */
  .fix {
    position: absolute;
    left: calc((100% - var(--gap) * 11) / 12 * 2 + var(--gap) * 1.5);
    top: calc(var(--t-title) * 0.6);
    width: 0.95rem;
    height: 0.82rem;
    transform: translate(-50%, -50%);
    overflow: visible;
  }

  .fix path {
    fill: var(--night);
    stroke: var(--ink-2);
    stroke-width: 1.4;
    stroke-linejoin: miter;
  }

  .current .fix path {
    fill: var(--ink);
    stroke: var(--ink);
  }

  @media (max-width: 48rem) {
    .legs {
      --route: 0.5rem;
      padding-left: 1.9rem;
      row-gap: var(--space-l);
    }

    .legs::after {
      display: none;
    }

    .when,
    .what,
    .sum {
      grid-column: 1 / -1;
      justify-self: start;
      text-align: left;
      padding: 0;
    }

    .when {
      order: -1;
      margin-bottom: var(--space-3xs);
    }

    .sum {
      margin-top: var(--space-2xs);
    }

    .fix {
      left: calc(0.5rem - 1.9rem);
      top: calc(var(--t-data) * 0.7);
    }
  }
</style>
